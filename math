<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>115 國中數學第一冊會考模擬測驗系統</title>
    <!-- 引入 Tailwind CSS 打造現代化美觀介面 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 MathJax 讓數學公式、根號、指數完美排版呈現 -->
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        body { font-family: 'PingFang TC', 'Microsoft JhengHei', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

    <!-- 頂部導覽列 -->
    <header class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white shadow-md py-6 px-4">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold">115 國中數學線上模擬測驗</h1>
                <p class="text-blue-100 text-sm mt-1">每次測驗包含：15 題選擇題 ＋ 5 題非選擇題</p>
            </div>
            <span class="bg-white/20 text-white px-3 py-1 rounded-full text-xs font-semibold">會考非選評分標準版</span>
        </div>
    </header>

    <main class="max-w-4xl mx-auto my-8 px-4">
        <!-- 步驟一：選擇章節畫面 -->
        <div id="setup-screen" class="bg-white rounded-2xl shadow-sm p-8 border border-slate-100">
            <h2 class="text-xl font-bold mb-6 text-slate-700 border-b pb-3">請選擇本次測驗章節</h2>
            <div id="chapter-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- 由 JS 動態生成 -->
            </div>
        </div>

        <!-- 步驟二：測驗進行畫面 -->
        <div id="quiz-screen" class="hidden">
            <!-- 進度條 -->
            <div class="bg-white rounded-full h-2 w-full mb-4 overflow-hidden shadow-inner">
                <div id="progress-bar" class="bg-blue-600 h-full w-0 transition-all duration-300"></div>
            </div>
            
            <div class="flex justify-between items-center mb-6">
                <span id="question-index" class="text-sm font-semibold text-slate-500">題目載入中...</span>
                <button onclick="confirmExit()" class="text-xs text-red-500 hover:underline">結束測驗</button>
            </div>

            <!-- 題目卡片 -->
            <div class="bg-white rounded-2xl shadow-sm p-8 border border-slate-100 min-h-[300px] flex flex-col justify-between">
                <div id="question-content" class="mb-6">
                    <!-- 題目文字 -->
                </div>

                <!-- 答題區：選擇題 -->
                <div id="mcq-options" class="space-y-3 hidden">
                    <!-- 4個選項按鈕 -->
                </div>

                <!-- 答題區：非選擇題 -->
                <div id="non-mcq-area" class="space-y-4 hidden">
                    <label class="block text-sm font-medium text-slate-600">請在下方輸入您的解題過程與最終答案：</label>
                    <textarea id="non-mcq-input" rows="6" class="w-full border border-slate-200 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="例：設綠色棉線共分成 x 段..."></textarea>
                </div>

                <!-- 下一步按鈕 -->
                <div class="mt-8 flex justify-end">
                    <button id="next-btn" onclick="handleNext()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-all shadow-sm">
                        下一題
                    </button>
                </div>
            </div>
        </div>

        <!-- 步驟三：結算與自評畫面 -->
        <div id="result-screen" class="hidden space-y-6">
            <div class="bg-white rounded-2xl shadow-sm p-8 border border-slate-100 text-center">
                <div class="inline-flex p-4 bg-emerald-50 rounded-full text-emerald-600 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">測驗完成！</h2>
                <p class="text-slate-500 mt-2">選擇題得分率：<span id="score-text" class="text-blue-600 font-bold text-xl">0%</span></p>
                <p class="text-slate-400 text-xs mt-1">（非選擇題請對照下方會考評分指引進行自評）</p>
                <button onclick="initQuizSetup()" class="mt-6 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-6 py-2 rounded-xl transition-all">返回首頁</button>
            </div>

            <!-- 非選擇題自評區 -->
            <div class="bg-white rounded-2xl shadow-sm p-8 border border-slate-100 space-y-8">
                <h3 class="text-lg font-bold text-slate-800 border-b pb-3 flex items-center gap-2">
                    <span>📝 非選擇題自評與解析對照</span>
                    <span class="text-xs font-normal text-slate-400">（請根據官方評分標準檢視自己的算式喔！）</span>
                </h3>
                <div id="self-eval-container" class="space-y-8 divide-y divide-slate-100">
                    <!-- 非選答案對照動態生成 -->
                </div>
            </div>
        </div>
    </main>

    <script>
        /************************************************************
         * 【⚠️ 您可以在此區域自行抽換/增減題庫欄位 ⚠️】
         * - mcq: 選擇題 pool (必須大於或等於15題以供隨機抽選，不夠則會全部呈現)
         * - nonMcq: 非選擇題 pool (必須大於或等於5題)
         * - 支援 LaTeX 語法，例如 \\(k^2\\) 或 \\[指數律\\]，網頁會自動排版渲染！
         ************************************************************/
        const quizDatabase = {
            "ch1": {
                "title": "CH1 整數的運算與科學記號",
                "mcq": [
                    { "q": "算式 \\(1＋｜(－5)－(－3)｜\\) 之值為何？", "opts": ["3", "9", "－1", "－7"], "ans": 0, "exp": "原式＝\\(1＋｜－5＋3｜＝1＋｜－2｜＝1＋2＝3\\)。" },
                    { "q": "算式 \\((－8)＋(－2)×(－3)\\) 之值為何？", "opts": ["－14", "－2", "18", "30"], "ans": 1, "exp": "先乘除後加減。原式＝\\((－8)＋6＝－2\\)。" },
                    { "q": "計算 \\(12÷(－3)－2×(－3)\\) 之值為何？", "opts": ["－18", "－10", "2", "18"], "ans": 2, "exp": "原式＝\\((－4)－(－6)＝－4＋6＝2\\)。" },
                    { "q": "算式 \\((－2)×|－5|－|－3|\\) 之值為何？", "opts": ["13", "7", "－13", "－7"], "ans": 2, "exp": "原式＝\\((－2)×5－3＝－10－3＝－13\\)。" },
                    { "q": "計算 \\((－3)^3＋5^2－(－2)^2\\) 之值為何？", "opts": ["2", "5", "－3", "－6"], "ans": 3, "exp": "原式＝\\(－27＋25－4＝－6\\)。" },
                    { "q": "計算 \\(7^3＋(－4)^3\\) 之值為何？", "opts": ["9", "27", "279", "407"], "ans": 2, "exp": "原式＝\\(343－64＝279\\)。" },
                    { "q": "計算 \\((－1)^3×(－2)^4÷(－3)^3\\) 之值為何？", "opts": ["\\(－\\frac{8}{3}\\)", "\\(－\\frac{16}{27}\\)", "\\(\\frac{16}{81}\\)", "\\(\\frac{16}{27}\\)"], "ans": 3, "exp": "原式＝\\((－1)×16÷(－27)＝\\frac{16}{27}\\)。" },
                    { "q": "將 \\(4.31×10^{－5}\\) 寫成小數形式，則其小數點後第四位數字為何？", "opts": ["0", "1", "3", "4"], "ans": 0, "exp": "寫成小數形式為 0.0000431。小數點後前四位皆為 0，故第四位數字為 0。" },
                    { "q": "下列哪一個數值最小？", "opts": ["\\(9.5×10^{－9}\\)", "\\(2.5×10^{－9}\\)", "\\(9.5×10^{－8}\\)", "\\(2.5×10^{－8}\\)"], "ans": 1, "exp": "比較科學記號大小時，先比指數。\\(10^{－9} < 10^{－8}\\)，再在同指數中比較，\\(2.5 < 9.5\\)，故 \\(2.5×10^{－9}\\) 最小。" },
                    { "q": "計算 \\([－(－3)^2＋3]÷6－4\\) 之值為何？", "opts": ["－2", "－3", "－5", "－6"], "ans": 2, "exp": "原式＝\\([－9＋3]÷6－4＝(－6)÷6－4＝－1－4＝－5\\)。" },
                    { "q": "根據規律：1 + 3 = 2^2，1 + 3 + 5 = 3^2。若 1 + 3 + 5 + 7 + 9 + 11 + 13 = k^2，且 k > 0，則 k 的值為何？", "opts": ["13", "7", "49", "14"], "ans": 1, "exp": "從 1 開始的連續奇數相加，其總和會等於『項數（總共有幾個數字）』的平方。共有 7 個奇數相加，故總和為 7^2，得 k = 7。" },
                    { "q": "若 \\(a＝3.2×10^{－5}，b＝7.5×10^{－5}，c＝6.3×10^{－6}\\)，則三數大小關係為何？", "opts": ["a < b < c", "a < c < b", "c < a < b", "c < b < a"], "ans": 2, "exp": "將 c 化為同指數：\\(c＝0.63×10^{－5}\\)，因為 \\(0.63 < 3.2 < 7.5\\)，所以 \\(c < a < b\\)。" },
                    { "q": "下列哪一個等式是正確的？", "opts": ["\\(2^3－(－2)^3＝0\\)", "\\(2^4－(－2^4)＝0\\)", "\\((－2)^3－(－2^3)＝0\\)", "\\((－2)^4－(－2^4)＝0\\)"], "ans": 2, "exp": "\\((－2)^3－(－2^3) ＝ －8 － (－8) ＝ 0\\)。選項D：\\((－2)^4－(－2^4) ＝ 16 － (－16) ＝ 32 ≠ 0\\)。" },
                    { "q": "計算 \\(19－(－2)×[(－12)－7]\\) 之值為何？", "opts": ["－1", "－19", "19", "47"], "ans": 1, "exp": "原式＝\\(19－(－2)×(－19)＝19－38＝－19\\)。" },
                    { "q": "計算 \\((－12)＋(－18)÷(－6)－(－3)×2\\) 之值為何？", "opts": ["－15", "－3", "11", "16"], "ans": 1, "exp": "原式＝\\((－12)＋3－(－6)＝－9＋6＝－3\\)。" }
                ],
                "nonMcq": [
                    {
                        "q": "使用小型計算機，計算 \\((－3)^5\\) 時，可如此按鍵：□3、□+/-、□y^x、□5，最後按□=。若按□1、□1、□2、□+/-、□y^x 各一次（次序自設）再按=，能得到的<b>最小數</b>是多少？請寫出過程與答案。",
                        "exp": "按鍵次序為□2、□+/-、□y^x、□1、□1、□=，即為算式 \\(－2^{11} ＝ －2048\\)。",
                        "rubric": [
                            "3 分：算式正確且求解過程合理，答案為 -2048 完整正確。",
                            "2 分：算式正確，求解合理但計算錯誤，或部分步驟未呈現其相關性。",
                            "1 分：算式只正確表示題目中部分數之關係，無完整求解過程。",
                            "0 分：空白或僅有答案，無任何合理之算式過程。"
                        ]
                    },
                    {
                        "q": "小酷玩射飛鏢遊戲。已知小酷射了五支飛鏢且都中靶，鏢靶配分為：＋2、－7、＋8、＋12。若小酷共得了 27 分，則他的五支飛鏢分別射中多少分？請寫下討論過程與理由。",
                        "exp": "因為得分 27 分為奇數，必有飛鏢得分為 －7 (只能為1支或3支，5支則小於0不合)。<br>(1) 只有1支射中－7：另外四支總分為 27－(－7)＝34，另外四支得分必為 12、12、8、2。<br>(2) 有3支射中－7：另外兩支總分為 27－3×(－7)＝48 (兩支最大 12×2=24 不合)。<br>故五支飛鏢得分為：－7、12、12、8、2分。",
                        "rubric": [
                            "3 分：觀念討論正確，求解過程完整且答案正確（－7、12、12、8、2）。",
                            "2 分：能經由討論找出正確答案，但討論情況不完整或有計算筆誤。",
                            "1 分：能經由嘗試找出正確答案，但完全未進行奇偶數情況的討論。",
                            "0 分：空白或僅寫出最終數字，沒有任何推導理由。"
                        ]
                    },
                    {
                        "q": "已知 \\(2^1－2^0＝1，2^2－(2^0＋2^1)＝1，2^3－(2^0＋2^1＋2^2)＝1\\)。若 \\(2^{100}－(□＋2^{10}＋2^{11}＋2^{12}＋……＋2^{99})＝1\\)，則□的值為何？",
                        "exp": "由已知規律，\\(2^{100}－(2^0＋2^1＋2^2＋……＋2^{99})＝1\\)。<br>比對題中等式，可知 □ 應等於前 10 項之和：<br>\\(□ ＝ 2^0＋2^1＋2^2＋……＋2^9\\)。<br>根據規律，\\((2^0＋2^1＋2^2＋……＋2^9) ＝ 2^{10}－1 ＝ 1024－1 ＝ 1023\\)。",
                        "rubric": [
                            "3 分：解題策略適切，推理過程合理且完整，答案 1023 正確。",
                            "2 分：能寫出 □ = 2^0 + 2^1 + ... + 2^9 = 2^10 - 1，但未能計算出 1023 終值。",
                            "1 分：僅能列出 □ = 2^0 + 2^1 + ... + 2^9，無法進一步簡化算式。",
                            "0 分：解題過程空白或與題目完全無關。"
                        ]
                    },
                    {
                        "q": "已知 \\(1＋3＝2^2、1＋3＋5＝3^2\\)...且 \\(121＝11^2、12321＝111^2、1234321＝1111^2\\)。若 \\(12345654321×(1＋3＋5＋7＋9＋11＋13)＝a^2 (a＞0)\\)，則 \\(a\\) 之值為何？",
                        "exp": "將算式拆解簡化：<br>\\(12345654321 ＝ 111111^2\\)<br>\\(1＋3＋5＋7＋9＋11＋13 ＝ 7^2\\) (共 7 個奇數)<br>故原式 \\(＝ 111111^2 × 7^2 ＝ (111111 × 7)^2 ＝ 777777^2\\)<br>因為 \\(a > 0\\)，故 \\(a ＝ 777777\\)。",
                        "rubric": [
                            "3 分：解題策略完全正確，過程合理且答案 777777 無誤。",
                            "2 分：能寫出 111111^2 * 7^2 = (111111 * 7)^2 的合併指數律，但答案計算筆誤。",
                            "1 分：僅能寫出各別平方數（111111^2 或 7^2），或位數多寫、少寫一個 7。",
                            "0 分：空白或僅猜出答案而無任何運算過程。"
                        ]
                    },
                    {
                        "q": "某次羽球課有 5 位同學一起練習。從上午 8:55 練習到上午 11:15，一直維持雙打形式（即必須同時有 4 人在上場練習）。請問平均一位同學上場的時間為多少分鐘？",
                        "exp": "1. 總練習時間：8:55 到 11:15 共經過 2 小時 20 分鐘 ＝ 140 分鐘。<br>2. 雙打場上總人時數：140 分鐘 × 4 人 ＝ 560 人分鐘。<br>3. 平均分配給 5 人：560 人分鐘 ÷ 5 人 ＝ 112 分鐘。<br>故平均每位同學上場 112 分鐘。",
                        "rubric": [
                            "3 分：計算出總時間、總人時數，且求解分配過程完整，答案 112 分鐘正確。",
                            "2 分：算式大致正確，但出現 60 進位計算錯誤（如算出 120 或 136）。",
                            "1 分：知道總時間為 140 分鐘，或僅寫出 140 * 4 = 560 後便無法繼續作答。",
                            "0 分：空白或回答與題意無關。"
                        ]
                    }
                ]
            },
            "ch2": {
                "title": "CH2 分數的運算（含因倍數）",
                "mcq": [
                    { "q": "若 \\(a、b、c\\) 均為質數，且 \\(a < b < c\\)，\\(a＋b＝25，b＋c＝54\\)，則 \\(c\\) 之值為何？", "opts": ["23", "29", "31", "41"], "ans": 2, "exp": "因為質數中除了2之外都是奇數，\\(a+b=25\\)(奇數)代表a、b中必有一個偶數。故偶數質數 \\(a = 2\\)，則 \\(b = 23\\)。代入 \\(b+c=54\\)，得 \\(c = 31\\)。" }
                ],
                "nonMcq": [
                    {
                        "q": "三條繩子長度分別為 \\(a\\) 公分、\\(b\\) 公分與 252 公分。今將它們剪成等長的整數公分繩段，共得 30 段。若每段長度介於 20 到 40 公分之間，求 \\(a+b\\) 的可能值為何？",
                        "exp": "每段長度必為 252 的因數，且在 20～40 之間，合格因數有：21、28、36 公分。<br>(1) 若每段長 21 公分：252 ÷ 21 = 12 段，則 a 與 b 共剪成 30 - 12 = 18 段，\\(a+b = 21 × 18 = 378\\)。<br>(2) 若每段長 28 公分：252 ÷ 28 = 9 段，則 a 與 b 共剪成 30 - 9 = 21 段，\\(a+b = 28 × 21 = 588\\)。<br>(3) 若每段長 36 公分：252 ÷ 36 = 7 段，則 a 與 b 共剪成 30 - 7 = 23 段，\\(a+b = 36 × 23 = 828\\)。<br>答：\\(a+b\\) 可能為 378、588 或 828。",
                        "rubric": [
                            "3 分：觀念正確，找出因數 21、28、36 並完整列出 3 種對應的 \\(a+b\\) 值。",
                            "2 分：解題過程完整但計算錯誤，或僅能找出 2 種狀況並算對其值。",
                            "1 分：僅知道每段長為 252 介於 20~40 的因數，或僅完整列出 1 種狀況。",
                            "0 分：空白或與題目無關。"
                        ]
                    }
                ]
            }
        };

        // 全域變態變數
        let currentChapter = "";
        let currentQuestions = [];
        let currentQuestionIndex = 0;
        let userMcqAnswers = []; // 儲存選擇題的回答狀況 (true/false)
        let userNonMcqAnswers = []; // 儲存非選題學生的文字回答

        // 初始化：渲染章節選擇
        function initQuizSetup() {
            document.getElementById('setup-screen').classList.remove('hidden');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            
            const listDiv = document.getElementById('chapter-list');
            listDiv.innerHTML = "";
            
            for (let chKey in quizDatabase) {
                const ch = quizDatabase[chKey];
                const btn = document.createElement('button');
                btn.className = "p-6 border border-slate-200 rounded-2xl text-left hover:border-blue-500 hover:bg-blue-50/50 transition-all group flex justify-between items-center";
                btn.onclick = () => startQuiz(chKey);
                btn.innerHTML = `
                    <div>
                        <h3 class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">${ch.title}</h3>
                        <p class="text-xs text-slate-400 mt-1">內含 ${ch.mcq.length} 題選擇，${ch.nonMcq.length} 題非選</p>
                    </div>
                    <span class="text-blue-500 font-semibold text-sm group-hover:translate-x-1 transition-transform">開始 →</span>
                `;
                listDiv.appendChild(btn);
            }
        }

        // 隨機自陣列抽選 N 個元素
        function getRandomSubset(arr, n) {
            let shuffled = [...arr].sort(() => 0.5 - Math.random());
            return shuffled.slice(0, n);
        }

        // 開始測驗：組裝試卷 (15選擇 + 5非選)
        function startQuiz(chapterKey) {
            currentChapter = chapterKey;
            const chData = quizDatabase[chapterKey];
            
            // 抽選題目（若題庫不夠則取上限）
            const selectedMcq = getRandomSubset(chData.mcq, 15).map(q => ({ ...q, type: 'mcq' }));
            const selectedNonMcq = getRandomSubset(chData.nonMcq, 5).map(q => ({ ...q, type: 'nonMcq' }));
            
            currentQuestions = [...selectedMcq, ...selectedNonMcq];
            currentQuestionIndex = 0;
            userMcqAnswers = [];
            userNonMcqAnswers = [];

            if(currentQuestions.length === 0) {
                alert("該章節目前沒有題目，請先於程式碼中加入題目。");
                return;
            }

            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            
            showQuestion();
        }

        // 顯示當前題目
        function showQuestion() {
            const q = currentQuestions[currentQuestionIndex];
            
            // 更新進度條與題號
            const progress = ((currentQuestionIndex) / currentQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progress}%`;
            
            const totalMcq = currentQuestions.filter(x => x.type === 'mcq').length;
            const qTypeLabel = q.type === 'mcq' ? `【選擇題】第 ${currentQuestionIndex + 1}/${totalMcq} 題` : `【非選擇題】第 ${currentQuestionIndex + 1 - totalMcq}/5 題`;
            document.getElementById('question-index').textContent = qTypeLabel;

            // 填入題目內容
            const contentDiv = document.getElementById('question-content');
            contentDiv.innerHTML = `<h3 class="text-lg font-medium text-slate-800 leading-relaxed">${q.q}</h3>`;

            // 切換答題面板
            const mcqDiv = document.getElementById('mcq-options');
            const nonMcqDiv = document.getElementById('non-mcq-area');
            
            if (q.type === 'mcq') {
                mcqDiv.classList.remove('hidden');
                nonMcqDiv.classList.add('hidden');
                
                // 動態產生 4 個選項
                mcqDiv.innerHTML = "";
                q.opts.forEach((opt, index) => {
                    const btn = document.createElement('button');
                    btn.className = "w-full text-left p-4 border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center gap-3";
                    btn.onclick = () => selectMcqOption(index, btn);
                    btn.innerHTML = `
                        <span class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-500">${String.fromCharCode(65 + index)}</span>
                        <span>${opt}</span>
                    `;
                    mcqDiv.appendChild(btn);
                });
                
                document.getElementById('next-btn').disabled = true; // 選擇後才能按下一步
                document.getElementById('next-btn').classList.add('opacity-50');
            } else {
                mcqDiv.classList.add('hidden');
                nonMcqDiv.classList.remove('hidden');
                
                // 清空非選輸入框
                document.getElementById('non-mcq-input').value = "";
                document.getElementById('next-btn').disabled = false;
                document.getElementById('next-btn').classList.remove('opacity-50');
            }

            // 排版渲染數學符號
            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        // 選擇選擇題選項
        let selectedOptionIndex = null;
        function selectMcqOption(index, element) {
            selectedOptionIndex = index;
            
            // 移除其他選項的選取樣式
            const buttons = document.getElementById('mcq-options').querySelectorAll('button');
            buttons.forEach(btn => {
                btn.classList.remove('border-blue-500', 'bg-blue-50/50');
                btn.querySelector('span').classList.remove('bg-blue-600', 'text-white');
                btn.querySelector('span').classList.add('bg-slate-100', 'text-slate-500');
            });

            // 幫當前選中的選項加上藍色框
            element.classList.add('border-blue-500', 'bg-blue-50/50');
            element.querySelector('span').classList.remove('bg-slate-100', 'text-slate-500');
            element.querySelector('span').classList.add('bg-blue-600', 'text-white');

            // 啟用「下一題」按鈕
            document.getElementById('next-btn').disabled = false;
            document.getElementById('next-btn').classList.remove('opacity-50');
        }

        // 處理「下一題」
        function handleNext() {
            const q = currentQuestions[currentQuestionIndex];
            
            if (q.type === 'mcq') {
                // 紀錄正誤
                const isCorrect = (selectedOptionIndex === q.ans);
                userMcqAnswers.push(isCorrect);
            } else {
                // 紀錄非選文字回答
                const inputVal = document.getElementById('non-mcq-input').value.trim();
                userNonMcqAnswers.push({
                    q: q.q,
                    userAnswer: inputVal || "（未作答）",
                    exp: q.exp,
                    rubric: q.rubric
                });
            }

            currentQuestionIndex++;

            if (currentQuestionIndex < currentQuestions.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        // 顯示成績與非選題自評對照
        function showResult() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            // 1. 計算選擇題得分
            const correctCount = userMcqAnswers.filter(x => x === true).length;
            const totalMcq = userMcqAnswers.length;
            const scorePercentage = totalMcq > 0 ? Math.round((correctCount / totalMcq) * 100) : 0;
            document.getElementById('score-text').textContent = `${scorePercentage}% (${correctCount}/${totalMcq} 題)`;

            // 2. 渲染非選題的學生答案、詳解及會考評分標準
            const container = document.getElementById('self-eval-container');
            container.innerHTML = "";

            if (userNonMcqAnswers.length === 0) {
                container.innerHTML = `<p class="text-slate-400 text-sm">本次測驗不包含任何非選擇題。</p>`;
                return;
            }

            userNonMcqAnswers.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = "pt-6 first:pt-0 space-y-4";
                
                // 生成評分指引的清單
                let rubricHtml = "";
                item.rubric.forEach(step => {
                    rubricHtml += `<li class="text-xs text-slate-600 list-disc ml-4 mt-1">${step}</li>`;
                });

                card.innerHTML = `
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <span class="inline-block bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded mb-2">非選第 ${index + 1} 題 題目</span>
                        <div class="text-sm font-medium text-slate-800">${item.q}</div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="border border-amber-100 bg-amber-50/20 p-4 rounded-xl">
                            <span class="text-xs font-bold text-amber-700">✍️ 您的解題紀錄：</span>
                            <pre class="text-xs text-slate-700 mt-2 whitespace-pre-wrap font-sans bg-white p-3 rounded border border-amber-100/50">${item.userAnswer}</pre>
                        </div>
                        <div class="border border-emerald-100 bg-emerald-50/20 p-4 rounded-xl">
                            <span class="text-xs font-bold text-emerald-700">💡 官方參考詳解與思維：</span>
                            <div class="text-xs text-slate-700 mt-2 bg-white p-3 rounded border border-emerald-100/50 leading-relaxed">${item.exp}</div>
                        </div>
                    </div>

                    <div class="border border-slate-200 p-4 rounded-xl bg-slate-100/30">
                        <span class="text-xs font-bold text-slate-500 flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>
                            會考非選評分指引（3分指標標準）
                        </span>
                        <ul class="mt-2 space-y-1">
                            ${rubricHtml}
                        </ul>
                    </div>
                `;
                container.appendChild(card);
            });

            // 排版渲染自評畫面的數學符號
            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        // 防呆離開提示
        function confirmExit() {
            if(confirm("確定要放棄本次測驗並返回首頁嗎？目前的答題進度將不會被儲存。")) {
                initQuizSetup();
            }
        }

        // 初始化載入
        window.onload = initQuizSetup;
    </script>
</body>
</html>
